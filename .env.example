# Copy to .env and fill in all five URLs. Never commit the real values.
# Existing environment variables override .env values.
UPLUS_AUTH_CHECKUP_URL=
UPLUS_AUTH_SUBMIT_URL=
UPLUS_COURSE_LIST_URL=
# Must end with / (the program appends the sign-in ID and /student).
UPLUS_COURSE_INFO_URL=
# Must end with ?signInId= or &signInId= (the program appends the ID).
UPLUS_SIGN_IN_URL=

# Optional: local web address.
WEB_ADDR=127.0.0.1:8097
